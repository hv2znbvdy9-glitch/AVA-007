{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ava-core/schemas/alert.schema.json",
  "title": "AVA Alert",
  "description": "Schema for alerts generated by the AVA CORE detection engine",
  "type": "object",
  "required": ["time", "type", "severity", "asset_id", "message"],
  "properties": {
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the alert was generated"
    },
    "type": {
      "type": "string",
      "enum": ["temperature", "current", "voltage", "network_anomaly", "unknown_ip", "port_anomaly", "connection_flood", "process_anomaly"],
      "description": "Alert category"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Alert severity level"
    },
    "asset_id": {
      "type": ["string", "null"],
      "description": "The asset this alert relates to (null for system-level alerts)"
    },
    "message": {
      "type": "string",
      "description": "Human-readable alert description"
    },
    "evidence": {
      "type": "object",
      "description": "Key-value pairs providing raw evidence for the alert"
    },
    "action_taken": {
      "type": ["string", "null"],
      "description": "Automated action taken in response to the alert, if any"
    },
    "acknowledged": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
